# Supabase — get these from https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct PostgreSQL connection or Supabase Session Pooler URI (server only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# require encrypts without CA verification; verify-full needs the Supabase CA certificate.
# Use disable only for a trusted local PostgreSQL instance.
DATABASE_SSL=require
# Only for DATABASE_SSL=verify-full. Use the PEM certificate from Supabase Database Settings.
DATABASE_CA_CERT=
CRON_SECRET=generate-a-long-random-secret

# Owner-only analytics at /aksesraffi. The UUID is the immutable Supabase Auth id
# returned by `npm run owner:provision`; access is denied when it is missing or malformed.
VERALEX_OWNER_USER_ID=
# Used once by the provisioning script to create the identity. Never a template value,
# never committed, and never sent to the browser. Omit it to leave the password alone.
VERALEX_OWNER_BOOTSTRAP_PASSWORD=

# Configure a single GTM container with GA4 and Google Ads tags.
# Example: GTM-ABC1234. Leave blank until the business account is ready.
NEXT_PUBLIC_GTM_ID=
